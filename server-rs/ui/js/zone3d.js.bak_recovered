  // 查表：id & 中文�?
  function fxById(id) {
    if (!id) return null;
    const s = String(id).toLowerCase();
    for (let i = 0; i < FX_LIBRARY.length; i++) {
      const e = FX_LIBRARY[i];
      if (e.id === s) return e;
      if (e.name === String(id)) return e;
    }
    return null;
  }
  // 随机兜底：未映射时按当前武器风格挑一个风格相符特�?
  function randomFx(styleHint) {
    const pool = FX_LIBRARY.filter(e => !styleHint || e.style === styleHint);
    const list = pool.length ? pool : FX_LIBRARY;
    return list[Math.random() * list.length | 0];
  }

  // —�?参数化生成入口：从某�?FX_LIBRARY 特效生成实际视觉 —�?
  function fxEmitter(entry) {
    if (!entry || !player) return;
    const col = FX_COLORS[entry.color] || 0xffffff;
    const shape = entry.shape || "orb";
    switch (shape) {
      case "arc":        emitArc(entry, col); break;
      case "blade":      emitBlade(entry, col); break;
      case "beam":       emitBeam(entry, col); break;
      case "orb":        emitOrb(entry, col); break;
      case "spire":      emitSpire(entry, col); break;
      case "helix":      emitHelix(entry, col); break;
      case "runering":   emitRing(entry, col); break;
      case "shockwave":  emitShock(entry, col); break;
      case "swordrain":  emitSwordRain(entry, col); break;
      case "bolt":       emitBolt(entry, col); break;
      case "flame":      emitFlame(entry, col); break;
      case "frost":      emitFrost(entry, col); break;
      case "void":       emitVoid(entry, col); break;
      case "warp":       emitWarp(entry, col); break;
      case "dragon":     emitDragon(entry, col); break;
      case "meteor":     emitMeteor(entry, col); break;
      default:           emitOrb(entry, col); break;
    }
    fxSfx(shape);
  }

  // 音效联动（可选加分）：不�?shape 触发不同 sfx（laser/hit/默认 blip）。AudioSys �?client.js，防御式调用�?
  function fxSfx(shape) {
    try {
      const A = (typeof window !== "undefined" && window.AudioSys) || null;
      if (!A || !A.sfx) return;
      if (shape === "beam" || shape === "bolt") A.sfx("laser");
      else if (shape === "blade" || shape === "arc" || shape === "swordrain") A.sfx("hit");
      else A.sfx();
    } catch (e) { /* 音效失败不阻�?*/ }
  }

  // —�?朝向基向�?/ 目标�?/ 起点（供 shape 构造器复用）—�?
  function fxDir() { return { x: Math.sin(yaw), z: Math.cos(yaw) }; }
  function fxTarget() {
    return enemy
      ? { x: enemy.position.x, y: 1.4, z: enemy.position.z }
      : { x: PX.x + Math.sin(yaw) * 4, y: 1.4, z: PX.z + Math.cos(yaw) * 4 };
  }
  function fxFrom(back = 0.8, h = 1.6) {
    const d = fxDir();
    return { x: PX.x + d.x * back, y: h, z: PX.z + d.z * back };
  }

  // —�?刀�?arc（弧形）：径向渐变圆�?+ additive 光晕 —�?
  function emitArc(entry, col) {
    const d = fxDir();
    const c = document.createElement("canvas"); c.width = c.height = 128;
    const ctx = c.getContext("2d");
    const g = ctx.createRadialGradient(64, 64, 4, 64, 64, 62);
    g.addColorStop(0, "rgba(255,255,255,.95)");
    g.addColorStop(0.55, hexToRgba(col, 0.6));
    g.addColorStop(1, hexToRgba(col, 0));
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(64, 64, 60, -1.15, 1.15); ctx.closePath(); ctx.fill();
    const tex = new THREE.CanvasTexture(c);
    const arc = new THREE.Mesh(
      new THREE.PlaneGeometry(2.1, 2.1),
      new THREE.MeshBasicMaterial({ map: tex, transparent: true, depthWrite: false, side: THREE.DoubleSide })
    );
    arc.position.set(PX.x + d.x * 1.4, 1.6, PX.z + d.z * 1.4);
    arc.rotation.y = -yaw;
    scene.add(arc);
    const glow = glowSprite(col, 2.4);
    glow.position.copy(arc.position); scene.add(glow);
    let t = 0;
    const anim = () => {
      t += 0.08;
      arc.scale.setScalar(1 + t * 1.6);
      arc.material.opacity = Math.max(0, 1 - t * 2.2);
      arc.position.x += d.x * 0.16; arc.position.z += d.z * 0.16;
      glow.position.set(arc.position.x, arc.position.y, arc.position.z);
      glow.material.opacity = Math.max(0.12, 1 - t * 1.8);
      glow.scale.setScalar(1 + t * 1.9);
      if (t < 0.55) requestAnimationFrame(anim);
      else { scene.remove(arc); arc.material.dispose(); tex.dispose(); scene.remove(glow); glow.material.dispose(); }
    };
    anim();
  }

  // —�?直线�?blade（剑�?光刃）：线性渐变薄�?+ 光晕 —�?
  function emitBlade(entry, col) {
    const d = fxDir();
    const c = document.createElement("canvas"); c.width = c.height = 64;
    const ctx = c.getContext("2d");
