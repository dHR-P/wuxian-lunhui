          m.position.set(px, s * 0.18, pz); m.rotation.z = Math.PI / 2; m.rotation.y = urnd() * 3.14;
        } else if (kind === 3) {          // 散落小箱
          m = new THREE.Mesh(new THREE.BoxGeometry(s * 0.7, s * 0.5, s * 0.7), crateSmallMat);
          m.position.set(px, s * 0.25, pz); m.rotation.y = urnd() * 3.14;
        } else if (kind === 4) {          // 沙袋�?
          m = new THREE.Mesh(new THREE.BoxGeometry(s * 1.1, s * 0.5, s * 0.5), sandbagMat);
          m.position.set(px, s * 0.25, pz); m.rotation.y = urnd() * 3.14;
        } else if (kind === 5) {          // 断墙残段（半高破损矮墙）
          m = new THREE.Mesh(new THREE.BoxGeometry(s * 1.4, s * 0.7, s * 0.3), brokenMat);
          m.position.set(px, s * 0.35, pz); m.rotation.y = urnd() * 3.14;
        } else if (kind === 6) {          // 暗色大型碎石（防落顶/混凝土块�?
          m = new THREE.Mesh(new THREE.BoxGeometry(s, s * 0.8, s * 0.9), darkStoneMat);
          m.position.set(px, s * 0.4, pz); m.rotation.y = urnd() * 3.14; m.rotation.x = 0.12;
        } else {                          // 散落砖块/杂物（随机小方块若干�?
          const n2 = 3 + Math.floor(urnd() * 3);
          for (let b2 = 0; b2 < n2; b2++) {
            const b = new THREE.Mesh(new THREE.BoxGeometry(0.16 + urnd() * 0.2, 0.12 + urnd() * 0.12, 0.2 + urnd() * 0.2), brokenMat);
            b.position.set(px + Math.cos(urnd() * 6.28) * 0.3, 0.06 + urnd() * 0.08, pz + Math.sin(urnd() * 6.28) * 0.3);
            b.rotation.y = urnd() * 6.28; b.rotation.z = urnd() * 0.5;
            add(b);
