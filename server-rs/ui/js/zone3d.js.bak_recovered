    const boneMat = new THREE.MeshStandardMaterial({ color: 0xb8b0a0, roughness: 0.9 });
    const pipeShortMat = new THREE.MeshStandardMaterial({ color: 0x8f9aa8, roughness: 0.6, metalness: 0.5 });
    const sandbagMat = new THREE.MeshStandardMaterial({ color: 0x6a6a3a, roughness: 1 });
    const crateSmallMat = new THREE.MeshStandardMaterial({ color: 0x6b5c42, roughness: 0.92 });
