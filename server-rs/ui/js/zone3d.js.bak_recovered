    if (/fula|梦魇|弗莱迪|freddy|dream/.test(r)) return "fulaidi";
    if (/tyrant|追踪者|追迹者|追赠/.test(r)) return "tyrant";
    if (/barbossa|巴博萨|海盗/.test(r)) return "barbossa";
    if (/dragon|�?.test(r)) return "dragon";
    if (/demon|恶魔/.test(r)) return "demon";
    if (/werew|狼人/.test(r)) return "werewolf";
    if (/golem|石魔像|魔像/.test(r)) return "golem";
    if (/tentacle|触手/.test(r)) return "tentacle";
    if (/undead|骷髅|skeleton|亡灵/.test(r)) return "undead";
    if (VOXEL_VARIANTS.hasOwnProperty(kind)) return kind; // guard/hunter/licker... 通用 kind 兜底
    return null;
  }

  // 体素配件系统：在通用 12 段基础上按 BOSS/kind 追加造型方块（挂点在 buildVoxelBody �?rig 枢轴�?
  function addVoxelAccessory(g, kind, refRaw) {
    const rig = (g.userData && g.userData.rig) || null;
    const vk = resolveVoxelVariant(kind, refRaw);
    const variant = vk ? VOXEL_VARIANTS[vk] : null;
    if (!variant) return;                       // 未匹�?�?保留通用 12 �?
    if (rig && variant.extraLean) {
      // 追加前�?弓背：同时写死到 upper �?rig.baseLean（animateRig �?baseLean 叠加攻击姿势，避免被覆盖�?
      rig.baseLean = (rig.baseLean || 0) + variant.extraLean;
      rig.upper.rotation.x = rig.baseLean;
    }
    if (variant.sc) g.scale.setScalar(variant.sc);                              // 覆盖体型缩放
    if (rig) {
      // 记录造型归属 + 动画枢轴收集桶（animateRig 读取�?idle 特征动画�?
      rig.variant = vk;
      rig.animParts = { tail: [], tent: [], wing: [] };
    }
    const boxAt = (parent, p) => {
      const m = new THREE.Mesh(
        new THREE.BoxGeometry(p.w, p.h, p.d),
        new THREE.MeshLambertMaterial({ color: p.c })
      );
      m.position.set(p.x, p.y, p.z);
      if (p.rot) { m.rotation.set(p.rot[0], p.rot[1], p.rot[2]); }
      if (p.glow !== undefined) { m.material.emissive = new THREE.Color(p.glow); m.material.emissiveIntensity = 1.0; }
      m.castShadow = true; m.receiveShadow = true;
      parent.add(m);
      return m;
    };
    (variant.parts || []).forEach(p => {
      // 选择挂点枢轴：U=upper 上身枢轴（头/�?肩）、AL/AR=左右肩枢轴、H=头部枢轴（头饰随头，适配各体型头高）
      const host = p.A === "AR" ? (rig && rig.armR)
        : p.A === "AL" ? (rig && rig.armL)
        : p.A === "H" ? (rig && rig.head)
        : (rig && rig.upper);
      if (!host) return;
      if (p.anim) {
        // 动画配件：包裹进枢轴 Group（tail/tent/wing），注册�?rig.animParts �?idle 摆动
        const grp = new THREE.Group();
        grp.position.set(p.x, p.y, p.z);
        grp.userData.base = (p.rot || [0, 0, 0]).slice();
        grp.userData.ph = Math.random() * 6.28;
        host.add(grp);
        boxAt(grp, { w: p.w, h: p.h, d: p.d, c: p.c, x: 0, y: -p.h / 2, z: 0, glow: p.glow });
        rig.animParts[p.anim].push(grp);
      } else {
        boxAt(host, p);
      }
    });
  }

  function spawnBlood(pos) {
    for (let i = 0; i < 20; i++) {
      const s = 0.09 + Math.random() * 0.13;
      const m = new THREE.Mesh(
        new THREE.BoxGeometry(s, s, s),
        new THREE.MeshBasicMaterial({ color: Math.random() < 0.6 ? 0x8a1414 : 0x5e0d0d, transparent: true })
      );
      m.position.set(pos.x, pos.y + Math.random() * 0.3, pos.z);
      scene.add(m);
      blood.push({
        m,
        vx: (Math.random() - 0.5) * 0.3,
        vy: 0.35 + Math.random() * 0.45,
        vz: (Math.random() - 0.5) * 0.3,
        spin: (Math.random() - 0.5) * 0.5,
        life: 0, max: 0.5 + Math.random() * 0.45,
      });
    }
  }
  function updateBlood(dt) {
    const scl = dt * 60;
    blood = blood.filter(b => {
      b.life += dt;
      const k = b.life / b.max;
      b.vy -= dt * 1.15;
      b.m.position.x += b.vx * scl;
      b.m.position.y += b.vy * scl;
      b.m.position.z += b.vz * scl;
      if (b.m.position.y < 0.03) { b.m.position.y = 0.03; b.vy *= -0.35; b.vx *= 0.7; b.vz *= 0.7; } // 落地轻弹即停
      b.m.rotation.x += b.spin * scl; b.m.rotation.z += b.spin * scl;
      b.m.scale.setScalar(Math.max(0.08, 1 - k * 0.7));
      b.m.material.opacity = Math.max(0, 1 - k * 1.5);
      if (k >= 1) { scene.remove(b.m); b.m.geometry.dispose(); b.m.material.dispose(); return false; }
      return true;
    });
  }

  // 投掷物（圣水 / 燃烧�?/ 投掷类道具）：从玩家手中抛出一个小球体，划出抛物弧飞向敌人�?
  // 命中（或到达目标点）时爆开成爆炸粒子。使�?blood 粒子系统做轨迹与爆散，全程逐帧�?updateThrowables 驱动�?
  // 纯视觉：命中判定/伤害�?Rust 侧，onAction 契约（attack）不变�?
  function throwFx() {
    if (!player) return;
    const dir = { x: Math.sin(yaw), z: Math.cos(yaw) };
    const from = { x: PX.x + dir.x * 0.7, y: 1.7, z: PX.z + dir.z * 0.7 };
    const to = enemy
      ? { x: enemy.position.x, y: 1.3, z: enemy.position.z }
      : { x: PX.x + dir.x * 4.2, y: 1.2, z: PX.z + dir.z * 4.2 };
    const isHoly = /圣水|holy|herb.?water|holy.?water/.test(String(curWeaponId || ""));
    // 投掷物本体：金属色小球弹�?+ additive 光晕（圣�?圣蓝，燃烧弹=橙红�?
    const ballColor = isHoly ? 0x7ad0ff : 0xff9a4a;
    const ball = new THREE.Mesh(
      new THREE.SphereGeometry(0.16, 12, 10),
      new THREE.MeshStandardMaterial({ color: ballColor, roughness: 0.35, metalness: 0.4, emissive: isHoly ? 0x2a6aff : 0xff6a20, emissiveIntensity: 0.9 })
    );
    ball.position.set(from.x, from.y, from.z);
    ball.castShadow = true;
    scene.add(ball);
    const trail = glowSprite(isHoly ? 0x8ae0ff : 0xffb066, 0.7);
    trail.position.copy(ball.position);
    scene.add(trail);
    // 起点手抛弧线：到目标的过程用二次贝塞尔，让投掷物画出一道内凹抛物线（更有「扔」的动感�?
    const ox = to.x - from.x, oy = to.y - from.y, oz = to.z - from.z;
    const apex = { x: from.x + ox * 0.5, y: Math.max(from.y, to.y) + 0.8, z: from.z + oz * 0.5 };
    const P = (k) => {
      const ik = 1 - k;
      return {
        x: ik * ik * from.x + 2 * ik * k * apex.x + k * k * to.x,
        y: ik * ik * from.y + 2 * ik * k * apex.y + k * k * to.y,
        z: ik * ik * from.z + 2 * ik * k * apex.z + k * k * to.z,
      };
    };
    throwables.push({ ball, trail, t: 0, P, to, isHoly, exploded: false });
  }

  // 推进所有飞行中的投掷物（每帧由 loop 调用 dt 秒）；到点后球体爆散 + 地面爆光�?
  function updateThrowables(dt) {
    const scl = dt * 60;
    throwables = throwables.filter(pr => {
      pr.t += dt;
      const k = Math.min(1, pr.t * 2.2);
      const p = pr.P(k);
      pr.ball.position.set(p.x, p.y, p.z);
      pr.ball.rotation.x += 0.3 * scl; pr.ball.rotation.z += 0.2 * scl;
      pr.trail.position.copy(pr.ball.position);
      pr.trail.material.opacity = Math.max(0.25, 1 - k * 0.7);
      if (k >= 1) {
        scene.remove(pr.ball); pr.ball.geometry.dispose(); pr.ball.material.dispose();
        scene.remove(pr.trail); pr.trail.material.dispose();
        // 命中爆炸：爆散粒子（圣水=圣蓝�?/ 燃烧�?橙红�?+ 地面亮斑
        const burstCol = pr.isHoly ? 0x8ee0ff : 0xffa050;
        const burstCol2 = pr.isHoly ? 0xffffff : 0xffd27a;
        for (let i = 0; i < 18; i++) {
          const m = new THREE.Mesh(
            new THREE.BoxGeometry(0.06 + Math.random() * 0.07, 0.06 + Math.random() * 0.07, 0.06 + Math.random() * 0.07),
            new THREE.MeshBasicMaterial({ color: i % 4 === 0 ? burstCol2 : burstCol, transparent: true, depthWrite: false })
          );
          m.position.set(pr.to.x, pr.to.y, pr.to.z);
          const a = Math.random() * 6.28, e = 0.7 + Math.random() * 1.1;
          scene.add(m);
          blood.push({
            m,
            vx: Math.cos(a) * e, vy: 0.3 + Math.random() * 1.5, vz: Math.sin(a) * e,
            spin: (Math.random() - 0.5) * 1.3,
            life: 0, max: 0.3 + Math.random() * 0.3,
          });
        }
        // 命中地面爆炸光斑（燃�?圣水溅射范围�?
        const flash = glowSprite(pr.isHoly ? 0xbfe8ff : 0xffb066, 1.8);
        flash.position.set(pr.to.x, 0.4, pr.to.z);
        scene.add(flash);
        setTimeout(() => { scene.remove(flash); flash.material.dispose(); }, 260);
        // 冲击地面环（一层扩散圆环贴片）
        const ring = new THREE.Mesh(
          new THREE.RingGeometry(0.25, 0.55, 24),
          new THREE.MeshBasicMaterial({ color: burstCol, transparent: true, opacity: 0.6, depthWrite: false, side: THREE.DoubleSide, blending: THREE.AdditiveBlending })
        );
        ring.rotation.x = -Math.PI / 2;
        ring.position.set(pr.to.x, 0.06, pr.to.z);
        scene.add(ring);
        let rt = 0;
        const ringA = () => {
          rt += 0.05;
          const s = 1 + rt * 1.8;
          ring.scale.set(s, s, s);
          ring.material.opacity = Math.max(0, 0.6 - rt * 1.4);
          if (rt < 0.45) requestAnimationFrame(ringA);
          else { scene.remove(ring); ring.geometry.dispose(); ring.material.dispose(); }
        };
        ringA();
        return false;
      }
      return true;
    });
  }

  // ---------- 手写 bloom（不引外部库）：additive 光晕精灵，给自发光体（刀�?能量）营造泛�?----------
  function getGlowTex() {
    if (glowTex) return glowTex;
    const c = document.createElement("canvas"); c.width = c.height = 64;
    const cx = c.getContext("2d");
    const g = cx.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, "rgba(255,255,255,1)");
    g.addColorStop(0.35, "rgba(255,255,255,.55)");
    g.addColorStop(1, "rgba(255,255,255,0)");
    cx.fillStyle = g; cx.fillRect(0, 0, 64, 64);
    glowTex = new THREE.CanvasTexture(c);
    return glowTex;
  }
  function glowSprite(color, size) {
    const s = new THREE.Sprite(new THREE.SpriteMaterial({
      map: getGlowTex(), color, transparent: true,
      blending: THREE.AdditiveBlending, depthWrite: false,
    }));
    s.scale.set(size, size, 1);
    return s;
  }

  // 体素人程序化动画（敌我同套；onAction 语义不变，纯视觉。每帧均为绝对赋值覆盖，旋转不累积）�?
  //   呼吸——upper 上下轻浮 + 前倾微摆；行走——四肢对侧摆（前�?后摆）、肘/膝随迈步屈伸、身体左右微晃；
  //   待机——头部偶尔转头（环顾�? 呼吸；攻击——三段（起手蓄力拉身后仰→前挥横扫→收招回位）；
  //   特殊�?idle——乘 rig.animParts 做触手蠕�?龙尾摆动/脑虫触须抖动/蝠翼扇动。rig �?buildVoxelBody 提供�?
  function animateRig(rig, t, walk, attack) {
    const moving = walk > 0.8;
    const sp = t * 0.018 * walk;
    const breath = Math.sin(t * 0.0017);
    // 呼吸：上半体起伏 + 极细微前倾摆�?
    rig.upper.position.y = breath * 0.035;
    rig.upper.rotation.z = Math.sin(sp) * 0.03;
    // 行走摆动：对侧手脚同步；前摆幅度略大于后摆（更自然）
    const ph = Math.sin(sp);
    const ls = moving ? ph * 0.46 : ph * 0.10;
    rig.legL.rotation.x = ls;
    rig.legR.rotation.x = -ls;
    // 手臂摆：幅度小于腿、前端探出；后摆由肘关节屈折补偿 �?摆动更分�?
    const as = moving ? 0.86 : 0.20;
    const armLx = -ls * 0.80 + (moving ? 0.14 : 0.02);
    const armRx = ls * 0.80 + (moving ? 0.14 : 0.02);
    rig.armL.rotation.x = armLx;
    rig.armR.rotation.x = armRx;
    if (rig.elbowL) rig.elbowL.rotation.x = (moving ? 0.28 : 0.14) - ls * 0.22; // 手肘随摆屈伸
    if (rig.elbowR) rig.elbowR.rotation.x = (moving ? 0.28 : 0.14) + ls * 0.22;
    // 膝盖随迈步微屈（支撑腿）
    if (rig.kneeL) rig.kneeL.rotation.x = Math.max(0, ls * 0.45);
    if (rig.kneeR) rig.kneeR.rotation.x = Math.max(0, -ls * 0.45);
    // 身体左右微晃（行走时轻微侧摆，像负重�?
    if (moving) rig.upper.rotation.z += Math.sin(sp * 0.5) * 0.04;
    // 待机 idle：头部偶尔转头（慢速环顾）+ 随呼吸轻点头；攻击时被下方覆�?
    if (rig.head && attack <= 0) {
      rig.head.rotation.y = Math.sin(t * 0.4) * 0.14;   // 慢速左右转�?
      rig.head.rotation.x = breath * 0.03;              // 呼吸轻点
    }
    // 身体基准 lean（buildVoxelBody 记录�?cfg.lean），攻击姿势在其上叠�?
    const baseX = rig.baseLean || 0;
    // 攻击三段：attack 单调 1�? 按值分 起手蓄力→前挥→收招（手�?+ 身体协同�?
    if (attack > 0) {
      const a = Math.min(1, attack);
      if (a > 0.78) {
        // �? 起手蓄力：上身后仰蓄�?+ 右臂拉后高举 + 右肘�?
        rig.upper.rotation.x = baseX + 0.20;
        rig.armR.rotation.x = -2.15; rig.armR.rotation.y = -0.18;
        rig.armL.rotation.x = 0.5;  rig.armL.rotation.y = 0.10;
        if (rig.elbowR) rig.elbowR.rotation.x = -0.65;
        if (rig.head) { rig.head.rotation.y = -0.15; rig.head.rotation.x = 0.10; }
      } else if (a > 0.30) {
        // �? 前挥：右臂大幅前探横�?+ 身体前送微�?
        const k = (a - 0.30) / 0.48;                    // 1�?
        rig.upper.rotation.x = baseX - 0.16 * k;
        rig.armR.rotation.x = 2.35 - 0.5 * (1 - k); rig.armR.rotation.y = 0.16;
        rig.armL.rotation.x = 0.34 - 0.18 * k; rig.armL.rotation.y = 0;
        if (rig.elbowR) rig.elbowR.rotation.x = -0.12 + 0.2 * k;
        if (rig.head) { rig.head.rotation.y = 0.12; rig.head.rotation.x = -0.12; }
      } else {
        // �? 收招回位：随 attack�? 平滑归零
        const k = a / 0.30;                              // 1�?
        rig.upper.rotation.x = baseX;
        rig.armR.rotation.x = 0.5 * k; rig.armR.rotation.y = 0;
        rig.armL.rotation.x = -0.2 * k; rig.armL.rotation.y = 0;
        if (rig.elbowR) rig.elbowR.rotation.x = 0.2 * k;
      }
    } else {
      // 非攻击：躯干 lean 归位（攻/受击后仰�?loop �?hurtLean 另行叠加�?
      rig.upper.rotation.x = baseX;
    }
    // 特殊�?idle 特征动画（基�?rig.animParts）：触手蠕动 / 龙尾摆动 / 脑虫触须抖动 / 蝠翼扇动
    const ap = rig.animParts;
    if (ap) {
      const a = t * 15;                                    // 时间相位（约 2.4Hz�?
      ap.tail.forEach((grp) => {
        grp.rotation.x = (grp.userData.base[0] || 0) + Math.sin(a + grp.userData.ph) * 0.30; // 尾上下摆
        grp.rotation.z = (grp.userData.base[2] || 0) + Math.sin(a * 0.6 + grp.userData.ph) * 0.18; // 尾横�?
      });
      ap.tent.forEach((grp) => {
        grp.rotation.z = (grp.userData.base[2] || 0) + Math.sin(a * 1.3 + grp.userData.ph) * 0.45;  // 触手左右蠕动
        grp.rotation.x = (grp.userData.base[0] || 0) + Math.sin(a + grp.userData.ph * 1.7) * 0.35;  // 触手前后�?
      });
      ap.wing.forEach((grp) => {
        grp.rotation.z = (grp.userData.base[2] || 0) + Math.sin(a * 0.8 + grp.userData.ph) * 0.30;  // 翼扇�?
      });
    }
  }

  // 攻击挥砍刀光（弧形渐变�?
  function swingFx() {
    if (!player) return;
    const c = document.createElement("canvas");
    c.width = c.height = 128;
    const ctx = c.getContext("2d");
    const g = ctx.createRadialGradient(64, 64, 4, 64, 64, 62);
    g.addColorStop(0, "rgba(255,255,255,.95)");
    g.addColorStop(0.55, "rgba(180,220,255,.55)");
    g.addColorStop(1, "rgba(150,200,255,0)");
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(64, 64, 60, -1.15, 1.15); ctx.closePath(); ctx.fill();
    const tex = new THREE.CanvasTexture(c);
    const arc = new THREE.Mesh(
      new THREE.PlaneGeometry(2.1, 2.1),
      new THREE.MeshBasicMaterial({ map: tex, transparent: true, depthWrite: false, side: THREE.DoubleSide })
    );
    // 从玩家朝向飞向敌人方向的刀�?
    const dir = { x: Math.sin(yaw), z: Math.cos(yaw) };
    arc.position.set(PX.x + dir.x * 1.4, 1.6, PX.z + dir.z * 1.4);
    arc.rotation.y = -yaw;
    scene.add(arc);
    // 手写 bloom：刀光中心叠�?additive 光晕（泛光感，帧率友好）
    const glow = glowSprite(0xaaddff, 2.4);
    glow.position.copy(arc.position);
    scene.add(glow);
    let t = 0;
    const anim = () => {
      t += 0.08;
      arc.scale.setScalar(1 + t * 1.6);
      arc.material.opacity = Math.max(0, 1 - t * 2.2);
      arc.position.x += dir.x * 0.16;
      arc.position.z += dir.z * 0.16;
      glow.position.set(arc.position.x, arc.position.y, arc.position.z);
      glow.material.opacity = Math.max(0.12, 1 - t * 1.8);
      glow.scale.setScalar(1 + t * 1.9);
      if (t < 0.55) requestAnimationFrame(anim);
      else {
        scene.remove(arc); arc.material.dispose(); tex.dispose();
        scene.remove(glow); glow.material.dispose();
      }
    };
    anim();
  }

  // 弹道（枪战）：从玩家朝向射出细长光束/子弹拖尾 + 枪口闪光 + 命中火花�?
  function shootFx() {
    if (!player) return;
    const dir = { x: Math.sin(yaw), z: Math.cos(yaw) };
    const start = { x: PX.x + dir.x * 0.6, y: 1.5, z: PX.z + dir.z * 0.6 };
    // 枪口闪光（additive 光晕�?
    const muzzle = glowSprite(0xffd27a, 0.5);
    muzzle.position.set(start.x, start.y, start.z);
    scene.add(muzzle);
    // 弹道主体：细长胶囊（沿朝向），兼具子弹拖�?
    const len = 1.6;
    const bullet = new THREE.Mesh(
      new THREE.CapsuleGeometry(0.045, len, 4, 8),
      new THREE.MeshBasicMaterial({ color: 0xffd98a, transparent: true, depthWrite: false })
    );
    bullet.rotation.x = Math.PI / 2;
    bullet.rotation.z = yaw - Math.PI / 2;
    scene.add(bullet);
    // 命中火花：目标敌人身�?pos 起爆一�?
    let hitPos = null;
    if (enemy) hitPos = { x: enemy.position.x, y: 1.4, z: enemy.position.z };
    spawnSpark(hitPos || { x: PX.x + dir.x * 2.4, y: 1.4, z: PX.z + dir.z * 2.4 }, 0xffb066, 10);
    let t = 0;
    const anim = () => {
      t += 0.06;
      bullet.position.set(start.x + dir.x * t * 4.2, start.y, start.z + dir.z * t * 4.2);
      bullet.material.opacity = Math.max(0, 1 - t * 2.6);
