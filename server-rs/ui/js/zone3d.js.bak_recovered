          skull.scale.set(1, 0.82, 1.08);
          skull.position.set(px + Math.cos(urnd() * 6.28) * 0.3, 0.2, pz + Math.sin(urnd() * 6.28) * 0.3);
          skull.rotation.y = urnd() * 3.14;
          m = skull;
        } else if (kind === 2) {          // 短管残段（横躺管道）
