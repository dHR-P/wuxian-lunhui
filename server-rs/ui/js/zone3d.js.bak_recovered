    const add = (m) => { m.castShadow = true; m.receiveShadow = true; scene.add(m); };

    const SIDE_SPOTS = [
      // 环形边带：每条边 4 个摆位点（避开中央战斗�?±5，让出走位空间）
      [-10, 3], [-10, -3.5], [-9.5, 7], [-9.5, -7], [10, 3], [10, -3.5], [9.5, 7], [9.5, -7],
      [3, -10], [-3, -10], [7, -9.5], [-7, -9.5], [3, 10], [-3, 10], [7, 9.5], [-7, 9.5],
    ];
    SIDE_SPOTS.forEach(([bx, bz], i) => {
      const kind = i % 8;
      // 每个摆位点以 1.5~2.8m 半径小簇散布 2~5 件杂�?
      const clusterN = 2 + Math.floor(urnd() * 4);
      for (let j = 0; j < clusterN; j++) {
        const ang = urnd() * 6.28, rr = urnd() * 0.9;
        const px = bx + Math.cos(ang) * rr, pz = bz + Math.sin(ang) * rr;
