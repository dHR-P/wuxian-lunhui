    const urnd = ((s) => () => { s = Math.sin(s * 127.1) * 43758.5453; return s - Math.floor(s); })(137104);
    // 场景会随副本进出重开，装饰统一集中�?buildProps 内一次性摆放，避免逐帧开销�?
