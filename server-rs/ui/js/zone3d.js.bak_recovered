    scene.add(warm);
    const cool = new THREE.PointLight(0x66aaff, 0.6, 20);
    cool.position.set(5, 5, 6);
    scene.add(cool);

    // 地板（AI 生成贴图�?
    const floorTex = new THREE.TextureLoader().load("assets/img/tex_floor_hive.png", t => {
