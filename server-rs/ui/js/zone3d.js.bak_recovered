        } else if (kind === 1) {          // 骸骨/骷髅（股�?+ 颅骨低模�?
          const bone = new THREE.Mesh(new THREE.CapsuleGeometry(s * 0.08, s * 0.6, 4, 6), boneMat);
          bone.position.set(px, 0.06, pz); bone.rotation.z = 1.2; bone.rotation.y = urnd() * 3.14;
