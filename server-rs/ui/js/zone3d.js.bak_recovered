    );
    beam.position.set(PX.x + d.x * 1.6, 1.75, PX.z + d.z * 1.6);
    beam.rotation.y = -yaw;
    scene.add(beam);
    const glow = glowSprite(col, 2.4); glow.position.copy(beam.position); scene.add(glow);
    let t = 0;
    const anim = () => {
      t += 0.07;
      beam.scale.set(1 + t * 2.2, 1, 1);
      beam.material.opacity = Math.max(0, 1 - t * 2.4);
      beam.position.x += d.x * 0.3; beam.position.z += d.z * 0.3;
      glow.position.set(beam.position.x, beam.position.y, beam.position.z);
      glow.material.opacity = Math.max(0.12, 1 - t * 1.6);
