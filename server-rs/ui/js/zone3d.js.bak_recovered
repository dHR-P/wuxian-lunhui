          return; // kind===7 已是散落砖块，本簇不必再 add 单件
        }
        add(m);
      }
    });
    // 额外地面贴片：几处干涸血�?油渍（战斗残留氛围）
    const extraStainPos = [[-8, -8], [8, 8], [-7, 6], [6, -7]];
    extraStainPos.forEach(([sx, sz], i) => {
      const st = makeStain(0.9 + urnd() * 0.6, i % 2 ? "rgba(40,34,22,.5)" : "rgba(96,14,14,.5)");
      st.position.set(sx, 0, sz);
