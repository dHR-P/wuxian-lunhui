          const m1 = new THREE.Mesh(new THREE.BoxGeometry(s * 0.8, s * 0.3, s * 0.6), stoneMat);
          m1.position.set(px, s * 0.15, pz); m1.rotation.y = urnd() * 3.14; m1.rotation.z = urnd() * 0.3;
